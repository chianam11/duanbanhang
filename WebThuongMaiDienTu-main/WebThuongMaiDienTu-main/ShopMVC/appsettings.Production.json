{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=ShopMVC_Prod;User Id=sa;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"
  },
  "ShopSettings": {
    "ShopName": "ShopMVC"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "templateFormat": "Json"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/shopmvc/production-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://+:443",
        "Certificate": {
          "Path": "/etc/ssl/certs/certificate.pfx",
          "Password": "YOUR_CERT_PASSWORD"
        }
      }
    },
    "Limits": {
      "MaxRequestBodySize": 104857600,
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "AspNetCore": {
    "ForwardedHeadersEnabled": true,
    "ForwardedHeadersKnownProxies": ["10.0.0.100"],
    "Urls": "https://+:443"
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@shopmvc.com",
    "SenderPassword": "YOUR_EMAIL_PASSWORD",
    "EnableSSL": true
  },
  "Features": {
    "EnableEmailNotifications": true,
    "EnableAnalytics": true,
    "EnableCaching": true,
    "CacheDurationMinutes": 60
  }
}
