@using Microsoft.AspNetCore.Identity
@using ShopMVC.Models
@inject SignInManager<NguoiDung> SignInManager
@inject UserManager<NguoiDung> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.HoTen;

    if (string.IsNullOrEmpty(displayName))
    {
        displayName = User.Identity?.Name ?? "User";
    }

    string? workspaceArea = null;
    string? workspaceController = null;
    string? workspaceAction = null;
    string? workspaceLabel = null;
    string? workspaceIcon = null;

    if (User.IsInRole("QuanTri"))
    {
        workspaceArea = "Admin";
        workspaceController = "Home";
        workspaceAction = "Index";
        workspaceLabel = "Trang quản trị";
        workspaceIcon = "bi-shield-lock-fill";
    }
    else if (User.IsInRole("NhanVien"))
    {
        workspaceArea = "Admin";
        workspaceController = "Home";
        workspaceAction = "Index";
        workspaceLabel = "Khu vực nhân viên";
        workspaceIcon = "bi-briefcase-fill";
    }
    else if (User.IsInRole("HoTroChat"))
    {
        workspaceArea = "Admin";
        workspaceController = "Chat";
        workspaceAction = "Index";
        workspaceLabel = "Trung tâm chat";
        workspaceIcon = "bi-headset";
    }

    <div class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark text-decoration-none d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle fs-4 me-1"></i>
            <span>@displayName</span>
        </a>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person-fill me-2"></i> Hồ sơ cá nhân
                </a>
            </li>

            @if (!string.IsNullOrWhiteSpace(workspaceArea) && !string.IsNullOrWhiteSpace(workspaceController) && !string.IsNullOrWhiteSpace(workspaceAction))
            {
                <li>
                    <a class="dropdown-item" asp-area="@workspaceArea" asp-controller="@workspaceController" asp-action="@workspaceAction">
                        <i class="bi @workspaceIcon me-2"></i> @workspaceLabel
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider"></li>

            <li>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/">
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex flex-row align-items-center">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        <a class="nav-link text-dark ms-2" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </div>
}
