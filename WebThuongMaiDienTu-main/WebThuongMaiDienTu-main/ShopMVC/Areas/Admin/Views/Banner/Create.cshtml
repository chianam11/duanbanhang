@model ShopMVC.Models.Banner

<div class="container mt-4">
    <h3>Thêm Banner Mới</h3>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label>Tên Banner</label>
            <input asp-for="TenBanner" class="form-control" />
            <span asp-validation-for="TenBanner" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Chọn Ảnh</label>
            <input type="file" name="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,.avif" required />
            <span class="text-danger field-validation-valid" data-valmsg-for="fileAnh" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label>Thứ Tự Hiển Thị</label>
            <input asp-for="ThuTu" class="form-control" value="1" type="number" />
            <span asp-validation-for="ThuTu" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="HienThi" class="form-check-input" checked />
            <label class="form-check-label">Hiển thị ngay</label>
        </div>

        <button type="submit" class="btn btn-success">Lưu Lại</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
