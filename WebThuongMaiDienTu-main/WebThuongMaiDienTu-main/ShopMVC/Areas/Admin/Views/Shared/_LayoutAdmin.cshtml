@inject ShopMVC.Services.Interfaces.IShopInfoService ShopInfoService
@{
    var shopName = await ShopInfoService.GetShopNameAsync();
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString();
    var isAdmin = User.IsInRole("QuanTri");
    var isStaff = User.IsInRole("NhanVien");
    var isChatSupport = User.IsInRole("HoTroChat");

    var panelTitle = isChatSupport && !isAdmin
        ? "Trung tâm hỗ trợ chat"
        : isStaff && !isAdmin
            ? "Khu vực nhân viên"
            : "Trang quản trị";

    var roleLabel = isChatSupport && !isAdmin
        ? "Hỗ trợ chat"
        : isStaff && !isAdmin
            ? "Nhân viên"
            : "Quản trị viên";

    var homeController = isChatSupport && !isAdmin ? "Chat" : "Home";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @panelTitle - @shopName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        body {
            font-size: .875rem;
            padding-top: 48px;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 48px 0 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }

        .sidebar-sticky {
            position: relative;
            top: 0;
            height: calc(100vh - 48px);
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .nav-link {
            font-weight: 500;
            color: #cfd8dc;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .nav-link:hover {
                color: #fff;
                background-color: rgba(255,255,255,0.1);
            }

            .nav-link.active {
                color: #fff;
                background-color: rgba(255,255,255,0.2);
                border-right: 4px solid #ec4899;
            }

            .nav-link i {
                font-size: 1.1rem;
            }

        .navbar-brand {
            padding-top: .75rem;
            padding-bottom: .75rem;
            font-size: 1rem;
            background-color: rgba(0, 0, 0, .25);
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .25);
        }

        .role-chip {
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 999px;
            color: #fff;
            font-size: .75rem;
            padding: .35rem .75rem;
            white-space: nowrap;
        }

        .workspace-caption {
            color: #94a3b8;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .08em;
        }
    </style>
</head>
<body>
    <header class="navbar navbar-dark fixed-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" asp-area="Admin" asp-controller="@homeController" asp-action="Index">@shopName</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="w-100 px-3 text-white d-flex align-items-center justify-content-between">
            <div>
                <div class="workspace-caption">@panelTitle</div>
                <div class="fw-semibold">@roleLabel</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="role-chip">@roleLabel</span>
                <a class="nav-link px-0 text-white" href="/">← Về trang bán hàng</a>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse">
                <div class="sidebar-sticky pt-3 text-white">
                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase">
                        <span>@panelTitle</span>
                    </h6>
                    <ul class="nav flex-column">
                        @if (isAdmin || isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "Home" ? "active" : "")"
                                   asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i>
                                    Tổng quan
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "DanhMuc" ? "active" : "")"
                                   asp-area="Admin" asp-controller="DanhMuc" asp-action="Index">
                                    <i class="bi bi-list-ul"></i>
                                    Danh mục
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "ThuongHieu" ? "active" : "")"
                                   asp-area="Admin" asp-controller="ThuongHieu" asp-action="Index">
                                    <i class="bi bi-tags"></i>
                                    Thương hiệu
                                </a>
                            </li>
                        }

                        @if (isAdmin || isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "SanPham" ? "active" : "")"
                                   asp-area="Admin" asp-controller="SanPham" asp-action="Index">
                                    <i class="bi bi-box-seam"></i>
                                    Sản phẩm
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "DonHang" ? "active" : "")"
                                   asp-area="Admin" asp-controller="DonHang" asp-action="Index">
                                    <i class="bi bi-bag-check"></i>
                                    Đơn hàng
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "Voucher" ? "active" : "")"
                                   asp-area="Admin" asp-controller="Voucher" asp-action="Index">
                                    <i class="bi bi-ticket-perforated"></i>
                                    Voucher / Mã giảm giá
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "DanhGia" ? "active" : "")"
                                   asp-area="Admin" asp-controller="DanhGia" asp-action="Index">
                                    <i class="bi bi-star-half"></i>
                                    Quản lý đánh giá
                                </a>
                            </li>
                        }

                        @if (isAdmin || isChatSupport)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "Chat" ? "active" : "")"
                                   asp-area="Admin" asp-controller="Chat" asp-action="Index">
                                    <i class="bi bi-chat-dots"></i>
                                    Hỗ trợ chat
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "Banner" ? "active" : "")"
                                   asp-area="Admin" asp-controller="Banner" asp-action="Index">
                                    <i class="bi bi-images"></i>
                                    Quản lý banner
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "CauHinh" ? "active" : "")"
                                   asp-area="Admin" asp-controller="CauHinh" asp-action="Index">
                                    <i class="bi bi-gear"></i>
                                    Cấu hình shop
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerName == "Dashboard" ? "active" : "")"
                                   asp-area="Admin" asp-controller="Dashboard" asp-action="Analytics">
                                    <i class="bi bi-graph-up-arrow"></i>
                                    Phân tích nâng cao
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
