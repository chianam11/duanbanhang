@model List<ShopMVC.Models.ChatSession>
@{
    ViewData["Title"] = "Hỗ trợ chat";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Hàng đợi hỗ trợ chat</h2>
        <p class="text-muted mb-0">Chỉ hiển thị các phiên chat đang mở và đã có tin nhắn từ khách hàng.</p>
    </div>
    <span class="badge bg-dark fs-6">@Model.Count phiên</span>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0" id="sessionTable">
            <thead class="table-light">
                <tr>
                    <th>Session</th>
                    <th>Khách hàng</th>
                    <th>Thời gian mở</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr id="emptyStateRow">
                        <td colspan="4" class="text-center py-5 text-muted">Chưa có phiên chat nào cần xử lý.</td>
                    </tr>
                }
                else
                {
                    @foreach (var session in Model)
                    {
                        var customerName = session.User?.HoTen ?? session.User?.Email ?? session.UserConnectionId;
                        <tr data-session-id="@session.Id">
                            <td class="fw-semibold">#@session.Id</td>
                            <td>@customerName</td>
                            <td>@session.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="ChiTiet" asp-route-id="@session.Id" class="btn btn-primary btn-sm">
                                    Mở hội thoại
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tableBody = document.querySelector("#sessionTable tbody");

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub?isAdmin=true")
                .build();

            connection.on("NewUserConnected", (sessionId, connectionId, displayName) => {
                document.getElementById("emptyStateRow")?.remove();

                if (tableBody.querySelector(`tr[data-session-id="${sessionId}"]`)) {
                    return;
                }

                const newRow = `
                    <tr data-session-id="${sessionId}">
                        <td class="fw-semibold">#${sessionId}</td>
                        <td>${displayName || "Khách hàng"}</td>
                        <td>Vừa xong</td>
                        <td class="text-end">
                            <a href="/Admin/Chat/ChiTiet/${sessionId}" class="btn btn-primary btn-sm">
                                Mở hội thoại
                            </a>
                        </td>
                    </tr>
                `;

                tableBody.insertAdjacentHTML("afterbegin", newRow);
            });

            connection.start().catch(err => console.error(err.toString()));
        });
    </script>
}
